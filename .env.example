APP_NAME="Arab UT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

COINS_CART_SECRET_RETENTION_HOURS=24
COINS_GUEST_CLAIM_RETENTION_HOURS=24
COINS_CART_RATE_LIMIT_PER_MINUTE=10

APP_LOCALE=en
N8N_CATALOG_KEY=
N8N_CATALOG_SECRET=
N8N_SBC_CATALOG_KEY=
N8N_SBC_CATALOG_SECRET=
N8N_PRICING_KEY=
N8N_PRICING_SECRET=
N8N_SBC_PRICING_READ_KEY=
N8N_SBC_PRICING_READ_SECRET=
N8N_CATALOG_MEDIA_HOSTS=
N8N_REVIEWS_URL=
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# Paylink hosted checkout. Use `test` until a complete pilot payment passes.
PAYLINK_ENV=test
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_WEBHOOK_TOKEN=

# Optional: Paylink Partner credentials are required only for API refunds.
PAYLINK_PARTNER_PROFILE_NO=
PAYLINK_PARTNER_API_KEY=
PAYLINK_MERCHANT_LOOKUP_KEY=accountNo
PAYLINK_MERCHANT_LOOKUP_VALUE=

# Signed paid-order outbox delivery to the Arab UT n8n webhook.
N8N_ORDER_PAID_URL=
N8N_ORDER_PAID_KEY=
N8N_ORDER_PAID_SECRET=

# Website Chat Foundation (Phase 1)
CHAT_ENABLED=false
CHAT_DEMO_ASSISTANT=false
# Lifecycle windows use last message activity; legacy nulls fall back to closed_at, then updated_at.
CHAT_AUTO_CLOSE_HOURS=24
CHAT_REOPEN_WITHIN_DAYS=7
CHAT_GUEST_RETENTION_DAYS=30
CHAT_USER_RETENTION_DAYS=180

# AI assistant runtime (Phase 2 remains disabled until a later approved rollout)
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_ROLLOUT=disabled
AI_ASSISTANT_TEST_USER_IDS=
AI_MODEL_PROVIDER=
AI_MODEL=gpt-5.6-luna
AI_TURN_DEBOUNCE_MS=1500
AI_MAX_CONTEXT_MESSAGES=24
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_RESPONSE_CHARACTERS=4000
AI_REASONING_EFFORT=low
AI_CONNECT_TIMEOUT_SECONDS=5
AI_STREAM_READ_TIMEOUT_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=45
AI_TURN_RATE_LIMIT_PER_MINUTE=6
AI_TURN_IP_RATE_LIMIT_PER_MINUTE=20
AI_MAX_ATTEMPTS=3
AI_RETRY_AFTER_CAP_MS=2000
AI_STALE_TURN_SECONDS=120
AI_FAKE_DELTA_DELAY_MS=350
OPENAI_API_KEY=
