# Arab UT - environment
#
# Sections and key order match .env.example, so a local file, a staging one and
# the production shared/.env can be diffed line by line. Keep them in step.
#
# REQUIRED  no working default; the feature is off or broken without it
# OPTIONAL  config/ carries a default that suits this store

# ------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------
APP_NAME="Arab UT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------
# Localization
# ------------------------------------------------------------------------
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
VITE_APP_NAME="Arab UT"

# ------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arab_ut_local
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------
# Session
# ------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------
# Cache, queue, storage
# ------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------
# The 'log' mailer accepts every message and delivers none, so it must never
# reach a deployed environment. Zoho requires an app-specific password when
# two-factor is on, and MAIL_FROM_ADDRESS must be a sender Zoho has verified or
# it rejects the message. Pick the host for the data centre the Zoho account
# lives in: smtp.zoho.com, smtp.zoho.eu, or smtp.zoho.sa.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=info@arab-ut.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@arab-ut.com
MAIL_FROM_NAME="Arab UT"

# ------------------------------------------------------------------------
# Storefront features
# ------------------------------------------------------------------------
STORE_LOYALTY_ENABLED=false
MY_ACCOUNT_ENABLED=true
LEGACY_HISTORY_ENABLED=false
INERTIA_SSR_ENABLED=false

# ------------------------------------------------------------------------
# Coins
# ------------------------------------------------------------------------
COINS_GUEST_CLAIM_RETENTION_HOURS=72
COINS_CART_RATE_LIMIT_PER_MINUTE=30
COINS_PRICING_RETENTION_DAYS=30

# ------------------------------------------------------------------------
# n8n automation
# ------------------------------------------------------------------------
N8N_CATALOG_KEY=
N8N_CATALOG_SECRET=
N8N_CATALOG_MEDIA_HOSTS=
N8N_SBC_CATALOG_KEY=
N8N_SBC_CATALOG_SECRET=
N8N_PRICING_KEY=
N8N_PRICING_SECRET=
N8N_SBC_PRICING_READ_KEY=
N8N_SBC_PRICING_READ_SECRET=
N8N_REVIEWS_URL=
N8N_ORDER_PAID_URL=
N8N_ORDER_PAID_KEY=
N8N_ORDER_PAID_SECRET=

# ------------------------------------------------------------------------
# Paylink checkout
# ------------------------------------------------------------------------
PAYLINK_ENV=test
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_WEBHOOK_TOKEN=
PAYLINK_PARTNER_PROFILE_NO=
PAYLINK_PARTNER_API_KEY=
PAYLINK_MERCHANT_LOOKUP_KEY=
PAYLINK_MERCHANT_LOOKUP_VALUE=

# ------------------------------------------------------------------------
# Google sign-in
# ------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------------
# WhatsApp
# ------------------------------------------------------------------------
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# ------------------------------------------------------------------------
# Chat
# ------------------------------------------------------------------------
CHAT_ENABLED=true
CHAT_DEMO_ASSISTANT=false
CHAT_AUTO_CLOSE_HOURS=24
CHAT_REOPEN_WITHIN_DAYS=7
CHAT_GUEST_RETENTION_HOURS=720
CHAT_USER_RETENTION_DAYS=180

# ------------------------------------------------------------------------
# AI assistant
# ------------------------------------------------------------------------
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_ROLLOUT=disabled
AI_ASSISTANT_TEST_USER_IDS=
AI_MODEL_PROVIDER=openai
# AgentRuntimeConfig pins these two to an exact value and fails the whole turn
# with configuration_invalid on anything else, so they are not free-form knobs.
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_RESPONSE_CHARACTERS=1200
AI_MAX_CONTEXT_MESSAGES=20
AI_TURN_DEBOUNCE_MS=400
AI_TURN_RATE_LIMIT_PER_MINUTE=12
AI_TURN_IP_RATE_LIMIT_PER_MINUTE=30
AI_CONNECT_TIMEOUT_SECONDS=5
AI_STREAM_READ_TIMEOUT_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_RETRY_AFTER_CAP_MS=2000
AI_STALE_TURN_SECONDS=60
AI_FAKE_DELTA_DELAY_MS=0
