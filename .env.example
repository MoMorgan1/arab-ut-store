# Arab UT - environment
#
# Sections and key order match .env.example, so a local file, a staging one and
# the production shared/.env can be diffed line by line. Keep them in step.
#
# REQUIRED  no working default; the feature is off or broken without it
# OPTIONAL  config/ carries a default that suits this store

# ------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------
APP_NAME="Arab UT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------
# Localization
# ------------------------------------------------------------------------
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
VITE_APP_NAME="Arab UT"

# ------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arab_ut_local
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------
# Session
# ------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------
# Cache, queue, storage
# ------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=info@arab-ut.com
MAIL_FROM_NAME="Arab UT"

# ------------------------------------------------------------------------
# Storefront features
# ------------------------------------------------------------------------
STORE_LOYALTY_ENABLED=false
MY_ACCOUNT_ENABLED=true
LEGACY_HISTORY_ENABLED=false
INERTIA_SSR_ENABLED=false

# ------------------------------------------------------------------------
# Coins
# ------------------------------------------------------------------------
COINS_CART_SECRET_RETENTION_HOURS=72
COINS_GUEST_CLAIM_RETENTION_HOURS=72
COINS_CART_RATE_LIMIT_PER_MINUTE=30
COINS_PRICING_RETENTION_DAYS=30

# ------------------------------------------------------------------------
# n8n automation
# ------------------------------------------------------------------------
N8N_CATALOG_KEY=
N8N_CATALOG_SECRET=
N8N_CATALOG_MEDIA_HOSTS=
N8N_SBC_CATALOG_KEY=
N8N_SBC_CATALOG_SECRET=
N8N_PRICING_KEY=
N8N_PRICING_SECRET=
N8N_SBC_PRICING_READ_KEY=
N8N_SBC_PRICING_READ_SECRET=
N8N_REVIEWS_URL=
N8N_ORDER_PAID_URL=
N8N_ORDER_PAID_KEY=
N8N_ORDER_PAID_SECRET=

# ------------------------------------------------------------------------
# Paylink checkout
# ------------------------------------------------------------------------
PAYLINK_ENV=test
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_WEBHOOK_TOKEN=
PAYLINK_PARTNER_PROFILE_NO=
PAYLINK_PARTNER_API_KEY=
PAYLINK_MERCHANT_LOOKUP_KEY=
PAYLINK_MERCHANT_LOOKUP_VALUE=

# ------------------------------------------------------------------------
# Google sign-in
# ------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------------
# WhatsApp
# ------------------------------------------------------------------------
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# ------------------------------------------------------------------------
# Chat
# ------------------------------------------------------------------------
CHAT_ENABLED=true
CHAT_DEMO_ASSISTANT=false
CHAT_AUTO_CLOSE_HOURS=24
CHAT_REOPEN_WITHIN_DAYS=7
CHAT_GUEST_RETENTION_HOURS=720
CHAT_USER_RETENTION_DAYS=180

# ------------------------------------------------------------------------
# AI assistant
# ------------------------------------------------------------------------
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_ROLLOUT=off
AI_ASSISTANT_TEST_USER_IDS=
AI_MODEL_PROVIDER=openai
AI_MODEL=gpt-5.6
OPENAI_API_KEY=
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_RESPONSE_CHARACTERS=1200
AI_MAX_CONTEXT_MESSAGES=20
AI_TURN_DEBOUNCE_MS=400
AI_TURN_RATE_LIMIT_PER_MINUTE=12
AI_TURN_IP_RATE_LIMIT_PER_MINUTE=30
AI_CONNECT_TIMEOUT_SECONDS=10
AI_STREAM_READ_TIMEOUT_SECONDS=60
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_ATTEMPTS=3
AI_RETRY_AFTER_CAP_MS=8000
AI_STALE_TURN_SECONDS=120
AI_FAKE_DELTA_DELAY_MS=0
